# 构建产物
build/bin/
dist/
frontend/dist/assets/
frontend/dist/*.js
frontend/dist/*.css
frontend/node_modules/

# 本地配置与数据（严禁提交）
config/settings.yaml
.env
data/
*.db
*.jsonl
# 例外：eval/samples 是 go:embed 的构建输入（gateeval.go），必须入库；
# 不入库则 CI 检出缺文件，go build/test 在 eval 包直接编译失败。
!eval/samples/*.jsonl

# 注意：frontend/wailsjs/ 为手写 bindings（wails dev/build 时官方生成器会覆盖），
# 保持入库以便纯前端构建；frontend/dist/index.html 为 go:embed 占位页，保持入库。

# 系统与编辑器
.DS_Store
.idea/
*.log

# .vscode 中的调试/任务配置属于项目资产，保持入库；仅忽略个人本地覆盖
.vscode/settings.local.json

.vscode/chrome-profile/

# OCR helper 为本地编译产物（源码 scripts/ocr_helper/main.swift，构建用 scripts/build-ocr-helper.sh）
scripts/ocr_helper/ocr_helper
