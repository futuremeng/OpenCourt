{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start-wails-server",
      "type": "shell",
      "command": "wails dev",
      "options": {
        "env": {
          "PATH": "${env:PATH}:${env:HOME}/go/bin",
          "GOPROXY": "https://goproxy.cn,direct"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "wails",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*\\.go):(\\d+):(\\d+):\\s+(\\w+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\s*•?\\s*(Building|Installing|Compiling).*",
          "endsPattern": "(Running application|DevServer listening on).*"
        }
      }
    },
    {
      "label": "attach-delve-to-desktop",
      "type": "shell",
      "command": "until PID=$(pgrep -x OpenCourt | head -1) && [ -n \"$PID\" ]; do sleep 1; done; dlv attach \"$PID\" --headless --listen=127.0.0.1:2345 --api-version=2",
      "options": {
        "env": {
          "PATH": "${env:PATH}:${env:HOME}/go/bin"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "delve",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "API server listening at.*"
        }
      }
    },
    {
      "label": "start-wails-then-dlv",
      "dependsOrder": "sequence",
      "dependsOn": ["start-wails-server", "attach-delve-to-desktop"],
      "problemMatcher": []
    },
    {
      "label": "start-chrome-waiting",
      "type": "shell",
      "command": "until lsof -nP -iTCP:34115 -sTCP:LISTEN >/dev/null 2>&1; do sleep 1; done; \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --remote-debugging-port=9222 --user-data-dir=${workspaceFolder}/.vscode/chrome-profile http://localhost:34115",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      // 打包形态调试支撑：产出带调试符号的 .app（配置 6 的 preLaunchTask）。
      "label": "wails-build-debug",
      "type": "shell",
      "command": "wails build -debug",
      "options": {
        "env": {
          "PATH": "${env:PATH}:${env:HOME}/go/bin",
          "GOPROXY": "https://goproxy.cn,direct"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "go-test-current-file",
      "type": "shell",
      "command": "go test -v ${fileDirname}",
      "options": {
        "env": {
          "GOPROXY": "https://goproxy.cn,direct"
        }
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
